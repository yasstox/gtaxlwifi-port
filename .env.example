# Copy to .env and fill in local-only values. Never commit .env.

# Workspace
GTAXL_ROOT=/workspace/gtaxlwifi-port
GTAXL_PMB_CFG=/workspace/gtaxlwifi-port/config/pmbootstrap-console.cfg

# SSH / postmarketOS login
GTAXL_SSH_USER=user
GTAXL_SSH_HOST=172.16.42.1
GTAXL_SSH_PASSWORD=CHANGE_ME

# Recovery / ADB
GTAXL_ADB_SUDO=1
GTAXL_RECOVERY_INSTALL_PARTITION=system
GTAXL_CACHE_DEVICE=/dev/mmcblk0p20
